        Overwrite="true"
        Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(VersionInfoFile)" />
    </ItemGroup>
  </Target>
  <Target Name="CommitVersion" AfterTargets="CoreCompile" Condition="'$(BuildingProject)' != 'false' and '$(BuildVersion)' != ''">
    <WriteLinesToFile File="$(VersionFilePath)" Lines="$(BuildVersion)" Overwrite="true" Encoding="UTF-8" />
