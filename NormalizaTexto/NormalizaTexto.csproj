  <Target Name="PrepareVersion">
    <ReadLinesFromFile File="$(VersionFilePath)">
      <Output TaskParameter="Lines" ItemName="_VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CurrentVersion>@(_VersionLines)</_CurrentVersion>
      <_Major>$(_CurrentVersion.Split('.')[0])</_Major>
      <_Minor>$(_CurrentVersion.Split('.')[1])</_Minor>
      <_Patch>$(_CurrentVersion.Split('.')[2])</_Patch>
      <_NewPatch>$([MSBuild]::Add($(_Patch), 1))</_NewPatch>
      <BuildVersion>$(_Major).$(_Minor).$(_NewPatch)</BuildVersion>
    </PropertyGroup>
    <Message Text="Building version $(BuildVersion)" Importance="high" />
  </Target>
  <Target Name="GenerateVersionInfo" DependsOnTargets="PrepareVersion" BeforeTargets="CoreCompile">
