# Normalize text files in the repository, keep Windows line endings in the working tree
* text=auto

*.sln        text eol=crlf
*.csproj     text eol=crlf
*.props      text eol=crlf
*.targets    text eol=crlf
*.cs         text eol=crlf
*.resx       text eol=crlf
*.settings   text eol=crlf
*.config     text eol=crlf
*.manifest   text eol=crlf
*.md         text eol=lf

*.png  binary
*.ico  binary
*.dll  binary
*.pdb  binary
*.exe  binary
